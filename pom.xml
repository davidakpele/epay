<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.epay</groupId>
    <artifactId>epay-server</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>epay-server</name>
    <description>ePay / Pesco distributed payments platform - multi-module parent</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <epay.version>1.0.0-SNAPSHOT</epay.version>
    </properties>

    <modules>
        <module>domain</module>
        <module>common</module>
        <module>auth</module>
        <module>wallet</module>
        <module>deposit</module>
        <module>withdraw</module>
        <module>virtual_card</module>
        <module>escrow</module>
        <module>beneficiary</module>
        <module>blacklist</module>
        <module>maintenance</module>
        <module>savings</module>
        <module>investment</module>
        <module>notification</module>
        <module>history</module>
        <module>admin</module>
        <module>main</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.epay</groupId>
                <artifactId>epay-domain</artifactId>
                <version>${epay.version}</version>
            </dependency>
            <dependency>
                <groupId>com.epay</groupId>
                <artifactId>epay-common</artifactId>
                <version>${epay.version}</version>
            </dependency>
            <dependency>
                <groupId>com.epay</groupId>
                <artifactId>epay-auth</artifactId>
                <version>${epay.version}</version>
            </dependency>
            <dependency>
                <groupId>com.epay</groupId>
                <artifactId>epay-wallet</artifactId>
                <version>${epay.version}</version>
            </dependency>
            <dependency>
                <groupId>com.epay</groupId>
                <artifactId>epay-deposit</artifactId>
                <version>${epay.version}</version>
            </dependency>
            <dependency>
                <groupId>com.epay</groupId>
                <artifactId>epay-withdraw</artifactId>
                <version>${epay.version}</version>
            </dependency>
            <dependency>
                <groupId>com.epay</groupId>
                <artifactId>epay-virtual-card</artifactId>
                <version>${epay.version}</version>
            </dependency>
            <dependency>
                <groupId>com.epay</groupId>
                <artifactId>epay-escrow</artifactId>
                <version>${epay.version}</version>
            </dependency>
            <dependency>
                <groupId>com.epay</groupId>
                <artifactId>epay-beneficiary</artifactId>
                <version>${epay.version}</version>
            </dependency>
            <dependency>
                <groupId>com.epay</groupId>
                <artifactId>epay-blacklist</artifactId>
                <version>${epay.version}</version>
            </dependency>
            <dependency>
                <groupId>com.epay</groupId>
                <artifactId>epay-maintenance</artifactId>
                <version>${epay.version}</version>
            </dependency>
            <dependency>
                <groupId>com.epay</groupId>
                <artifactId>epay-savings</artifactId>
                <version>${epay.version}</version>
            </dependency>
            <dependency>
                <groupId>com.epay</groupId>
                <artifactId>epay-investment</artifactId>
                <version>${epay.version}</version>
            </dependency>
            <dependency>
                <groupId>com.epay</groupId>
                <artifactId>epay-notification</artifactId>
                <version>${epay.version}</version>
            </dependency>
            <dependency>
                <groupId>com.epay</groupId>
                <artifactId>epay-history</artifactId>
                <version>${epay.version}</version>
            </dependency>
            <dependency>
                <groupId>com.epay</groupId>
                <artifactId>epay-admin</artifactId>
                <version>${epay.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

</project>
