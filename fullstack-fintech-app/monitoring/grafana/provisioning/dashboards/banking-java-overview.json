{
  "title": "Banking — Java Microservices Overview",
  "uid": "banking-java-overview",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["banking", "java", "microservices"],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "-- Default --" },
        "query": "label_values(up{job!=\"prometheus\"}, job)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Services UP",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "-- Default --" },
          "expr": "count(up{job!=\"prometheus\"} == 1)",
          "legendFormat": "UP"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Services DOWN",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "-- Default --" },
          "expr": "count(up{job!=\"prometheus\"} == 0) or vector(0)",
          "legendFormat": "DOWN"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total RPS (all services)",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "-- Default --" },
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"$service\"}[1m]))",
          "legendFormat": "RPS"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Overall Error Rate",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "-- Default --" },
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\", job=~\"$service\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=~\"$service\"}[5m]))",
          "legendFormat": "Error %"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Total Services Monitored",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "options": { "colorMode": "value", "graphMode": "none" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "-- Default --" },
          "expr": "count(up{job!=\"prometheus\"})",
          "legendFormat": "Total"
        }
      ]
    },
    {
      "type": "table",
      "title": "Service Health Status",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 6 },
      "options": { "sortBy": [{ "displayName": "Status" }] },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              { "id": "displayName", "value": "Status" },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "1": { "text": "UP", "color": "green" } } },
                  { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" } } }
                ]
              },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "-- Default --" },
          "expr": "up{job!=\"prometheus\"}",
          "legendFormat": "{{job}}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "renameByName": { "job": "Service", "Value": "Status" } } }
      ]
    },
    {
      "type": "timeseries",
      "title": "Request Rate per Service",
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "-- Default --" },
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"$service\"}[1m])) by (job)",
          "legendFormat": "{{ job }}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "P99 Latency per Service",
      "gridPos": { "x": 12, "y": 10, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "-- Default --" },
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{job=~\"$service\"}[5m])) by (le, job))",
          "legendFormat": "P99 {{ job }}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM Heap Used vs Max",
      "gridPos": { "x": 0, "y": 18, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "-- Default --" },
          "expr": "jvm_memory_used_bytes{area=\"heap\", job=~\"$service\"}",
          "legendFormat": "{{ job }} used"
        },
        {
          "datasource": { "type": "prometheus", "uid": "-- Default --" },
          "expr": "jvm_memory_max_bytes{area=\"heap\", job=~\"$service\"}",
          "legendFormat": "{{ job }} max"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Active HTTP Threads per Service",
      "gridPos": { "x": 12, "y": 18, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "-- Default --" },
          "expr": "tomcat_threads_busy_threads{job=~\"$service\"}",
          "legendFormat": "{{ job }}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HikariCP Active DB Connections",
      "gridPos": { "x": 0, "y": 26, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "-- Default --" },
          "expr": "hikaricp_connections_active{job=~\"$service\"}",
          "legendFormat": "{{ job }}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GC Pause Time per Service",
      "gridPos": { "x": 12, "y": 26, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "-- Default --" },
          "expr": "rate(jvm_gc_pause_seconds_sum{job=~\"$service\"}[5m])",
          "legendFormat": "{{ job }} [{{ cause }}]"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU Usage per Service",
      "gridPos": { "x": 0, "y": 34, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "-- Default --" },
          "expr": "process_cpu_usage{job=~\"$service\"}",
          "legendFormat": "{{ job }}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Open File Descriptors",
      "gridPos": { "x": 12, "y": 34, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "-- Default --" },
          "expr": "process_open_fds{job=~\"$service\"}",
          "legendFormat": "{{ job }}"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Live Logs — Java Services",
      "gridPos": { "x": 0, "y": 42, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki-uid" },
      "options": {
        "showTime": true,
        "showLabels": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "enableLogDetails": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki-uid" },
          "expr": "{service=~\"$service\"} |= ``",
          "legendFormat": ""
        }
      ]
    }
  ]
}