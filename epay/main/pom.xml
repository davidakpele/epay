<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.epay</groupId>
        <artifactId>epay-server</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>main</artifactId>
    <packaging>jar</packaging>
    <name>ePay Main Module</name>
    <description>Single Spring Boot entry point - scans and wires up every module</description>

    <dependencies>
        <dependency>
            <groupId>com.epay</groupId>
            <artifactId>epay-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.epay</groupId>
            <artifactId>epay-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.epay</groupId>
            <artifactId>epay-bank</artifactId>
        </dependency>
        <dependency>
            <groupId>com.epay</groupId>
            <artifactId>epay-wallet</artifactId>
        </dependency>
        <dependency>
            <groupId>com.epay</groupId>
            <artifactId>epay-notification</artifactId>
        </dependency>
        <dependency>
            <groupId>com.epay</groupId>
            <artifactId>epay-deposit</artifactId>
        </dependency>
        <dependency>
            <groupId>com.epay</groupId>
            <artifactId>epay-withdraw</artifactId>
        </dependency>
        <dependency>
            <groupId>com.epay</groupId>
            <artifactId>epay-virtual-card</artifactId>
        </dependency>
        <dependency>
            <groupId>com.epay</groupId>
            <artifactId>epay-escrow</artifactId>
        </dependency>
        <dependency>
            <groupId>com.epay</groupId>
            <artifactId>epay-beneficiary</artifactId>
        </dependency>
        <dependency>
            <groupId>com.epay</groupId>
            <artifactId>epay-blacklist</artifactId>
        </dependency>
        <dependency>
            <groupId>com.epay</groupId>
            <artifactId>epay-maintenance</artifactId>
        </dependency>
        <dependency>
            <groupId>com.epay</groupId>
            <artifactId>epay-savings</artifactId>
        </dependency>
        <dependency>
            <groupId>com.epay</groupId>
            <artifactId>epay-investment</artifactId>
        </dependency>
        <dependency>
            <groupId>com.epay</groupId>
            <artifactId>epay-history</artifactId>
        </dependency>
        <dependency>
            <groupId>com.epay</groupId>
            <artifactId>epay-bills</artifactId>
        </dependency>
        <dependency>
            <groupId>com.epay</groupId>
            <artifactId>epay-admin</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>epay-server</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
