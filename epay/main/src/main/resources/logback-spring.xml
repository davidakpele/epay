<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

  <!-- ── Properties ──────────────────────────────────────────────────── -->
  <springProperty scope="context" name="appName"  source="spring.application.name" defaultValue="epay-server"/>
  <springProperty scope="context" name="logLevel" source="logging.level.root"       defaultValue="INFO"/>

  <property name="LOG_DIR"        value="/var/log/epay"/>
  <property name="AUDIT_LOG_FILE" value="${LOG_DIR}/audit.log"/>
  <property name="APP_LOG_FILE"   value="${LOG_DIR}/app.log"/>

  <!--
    Trace correlation in Spring Boot 4.x works differently from Boot 3.x:
      - Boot 4.x auto-prepends a correlation ID to every log line when
        micrometer-tracing is on the classpath.
      - The format is controlled by logging.pattern.correlation in application.yaml,
        set to "[appName,traceId,spanId] ".
      - Spring Boot injects this BEFORE the logger name automatically — we do NOT
        need %X{traceId} in this pattern. Adding it would duplicate the IDs.

    Log line format with tracing active:
      2026-09-14 08:12:34 [http-nio-8029-exec-3] INFO  [epay-server,4f3a1b2c,2b3c4d5e] c.e.w.WalletService - msg
      └── this part ──────────────────────────────────────────────────────────────────────────────────────────┘
                                                       └── auto-injected by Boot 4.x ──┘

    Without an active trace (e.g. actuator health checks):
      2026-09-14 08:12:34 [http-nio-8029-exec-1] INFO  [epay-server,-,-] c.e.a.HealthController - msg
  -->
  <property name="LOG_PATTERN"
            value="%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n"/>

  <!-- ── Console (human-readable for dev) ────────────────────────────── -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${LOG_PATTERN}</pattern>
    </encoder>
  </appender>

  <!-- ── Application log (rolling, plain text) ────────────────────────── -->
  <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${APP_LOG_FILE}</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/app.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>50MB</maxFileSize>
      <maxHistory>7</maxHistory>
      <totalSizeCap>500MB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>${LOG_PATTERN}</pattern>
    </encoder>
  </appender>

  <!-- ── Audit log (one JSON object per line — parsed by Promtail) ──── -->
  <!--
    Raw passthrough — the audit filter writes a complete JSON string per line.
    traceId/spanId should be embedded in the JSON by the audit filter itself.
  -->
  <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${AUDIT_LOG_FILE}</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/audit.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>100MB</maxFileSize>
      <maxHistory>30</maxHistory>
      <totalSizeCap>2GB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>%msg%n</pattern>
    </encoder>
  </appender>

  <!-- ── Loggers ──────────────────────────────────────────────────────── -->

  <!-- audit.request → ONLY the audit file, not the general app log -->
  <logger name="audit.request" level="INFO" additivity="false">
    <appender-ref ref="AUDIT_FILE"/>
  </logger>

  <!-- Suppress noisy libraries -->
  <logger name="org.hibernate.SQL"                                              level="WARN"/>
  <logger name="org.hibernate.type.descriptor.sql"                              level="WARN"/>
  <logger name="org.springframework.security.web.FilterChainProxy"              level="WARN"/>
  <logger name="org.springframework.web.servlet.mvc.method.annotation"          level="WARN"/>
  <logger name="io.lettuce"                                                      level="WARN"/>
  <logger name="com.zaxxer.hikari"                                               level="WARN"/>

  <!-- Silence Zipkin reporter INFO noise (logs every span batch dispatch).
       Set to DEBUG only when troubleshooting why spans are not arriving. -->
  <logger name="zipkin2.reporter"                                               level="WARN"/>
  <logger name="io.micrometer.tracing"                                          level="WARN"/>

  <!-- Root -->
  <root level="${logLevel}">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="APP_FILE"/>
  </root>

</configuration>
